{
  "uid": "caib-mod-github-audit",
  "title": "CAIB Module: github_audit",
  "tags": [
    "caib",
    "github_audit"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Events per hour",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(bucket, '1h') AS time, outcome AS metric, sum(n)::float AS value FROM caib.events_5m WHERE module = 'github_audit' AND $__timeFilter(bucket) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Top actors (24h)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT actor, sum(n) AS events, sum(failures) AS failures FROM caib.actors_1h WHERE module = 'github_audit' AND bucket > now() - interval '24 hours' AND actor IS NOT NULL GROUP BY actor ORDER BY events DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "actor"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "action"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "target"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "src_ip"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Top actions (24h)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT action, sum(n) AS events FROM caib.events_5m WHERE module = 'github_audit' AND bucket > now() - interval '24 hours' GROUP BY action ORDER BY events DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "actor"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "action"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "target"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "src_ip"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Recent access & protection changes",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT event_time, actor, action, target, coalesce(attrs->>'visibility', attrs->>'permission', attrs->>'repository_selection', attrs->>'branch') AS detail, host(src_ip) AS src_ip FROM caib.events WHERE module = 'github_audit' AND $__timeFilter(event_time) AND (action IN ('repo.access', 'org.add_member', 'org.update_member', 'org.remove_member', 'protected_branch.destroy', 'repository_ruleset.destroy', 'repository_ruleset.update', 'personal_access_token.access_granted', 'integration_installation.create', 'org_credential_authorization.grant', 'org.oauth_app_access_approved') OR action LIKE '%.disable%') ORDER BY event_time DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "actor"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "action"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "target"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "src_ip"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "description": "Visibility, org-role, branch-protection, ruleset and token/app grant events. GitHub's audit log has no success/failure field, so a failures panel would always be empty."
    },
    {
      "id": 5,
      "type": "table",
      "title": "Changes by audit category (24h)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT coalesce(attrs->>'category', 'unknown') AS category, count(*) AS events FROM caib.events WHERE module = 'github_audit' AND event_time > now() - interval '24 hours' GROUP BY 1 ORDER BY events DESC LIMIT 10"
        }
      ],
      "description": "First segment of the action name (repo, org, protected_branch, ...). Raw table, 24h only."
    },
    {
      "id": 6,
      "type": "table",
      "title": "Web vs token-driven changes (24h)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT coalesce(attrs->>'programmatic_access_type', 'web') AS access, count(*) AS events FROM caib.events WHERE module = 'github_audit' AND event_time > now() - interval '24 hours' GROUP BY 1 ORDER BY events DESC"
        }
      ],
      "description": "attrs.programmatic_access_type; 'web' means the field was absent (browser session). Raw table, 24h only."
    },
    {
      "id": 7,
      "type": "table",
      "title": "Raw event stream",
      "description": "Newest github_audit events in the selected range. Click a cell in attrs/raw to inspect the full JSON; column headers filter.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "attrs"
            },
            "properties": [
              {
                "id": "custom.inspect",
                "value": true
              },
              {
                "id": "custom.width",
                "value": 220
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "raw"
            },
            "properties": [
              {
                "id": "custom.inspect",
                "value": true
              },
              {
                "id": "custom.width",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "actor"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "action"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "target"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "src_ip"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT event_time, actor, action, target, outcome, severity, host(src_ip) AS src_ip, attrs::text AS attrs, raw::text AS raw FROM caib.events WHERE module = 'github_audit' AND $__timeFilter(event_time) ORDER BY event_time DESC LIMIT 100"
        }
      ]
    }
  ]
}
