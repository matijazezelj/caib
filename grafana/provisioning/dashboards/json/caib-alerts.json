{
  "uid": "caib-alerts",
  "title": "CAIB Alerts",
  "tags": ["caib"],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "status",
        "type": "custom",
        "label": "Status",
        "multi": true,
        "includeAll": false,
        "query": "open,ack,closed",
        "current": { "text": ["open"], "value": ["open"] },
        "options": [
          { "text": "open", "value": "open", "selected": true },
          { "text": "ack", "value": "ack", "selected": false },
          { "text": "closed", "value": "closed", "selected": false }
        ]
      },
      {
        "name": "severity",
        "type": "custom",
        "label": "Severity",
        "multi": true,
        "includeAll": false,
        "query": "critical,high,medium,low,info",
        "current": {
          "text": ["critical", "high", "medium", "low", "info"],
          "value": ["critical", "high", "medium", "low", "info"]
        },
        "options": [
          { "text": "critical", "value": "critical", "selected": true },
          { "text": "high", "value": "high", "selected": true },
          { "text": "medium", "value": "medium", "selected": true },
          { "text": "low", "value": "low", "selected": true },
          { "text": "info", "value": "info", "selected": true }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 3,
      "type": "stat",
      "title": "",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "caib" },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Critical/high open" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "red", "value": 1 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Open" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 1 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE status = 'open')::int AS \"Open\", count(*) FILTER (WHERE status = 'open' AND severity IN ('critical','high'))::int AS \"Critical/high open\", count(*) FILTER (WHERE first_seen > now() - interval '24 hours')::int AS \"New (24h)\", count(*) FILTER (WHERE last_seen > now() - interval '24 hours' AND first_seen <= now() - interval '24 hours')::int AS \"Recurring (24h)\" FROM detect.alerts"
        }
      ]
    },
    {
      "id": 1,
      "type": "table",
      "title": "Alerts",
      "description": "Click entity/context cells to inspect the full JSON. rule_id, dedup key and first_seen live in the Details row below.",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "caib" },
      "fieldConfig": {
        "defaults": { "custom": { "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "severity" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": { "color": "dark-red", "index": 0 },
                      "high": { "color": "red", "index": 1 },
                      "medium": { "color": "orange", "index": 2 },
                      "low": { "color": "yellow", "index": 3 },
                      "info": { "color": "blue", "index": 4 }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "custom.width", "value": 100 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "last_seen" },
            "properties": [{ "id": "custom.width", "value": 180 }]
          },
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [{ "id": "custom.width", "value": 90 }]
          },
          {
            "matcher": { "id": "byName", "options": "events" },
            "properties": [{ "id": "custom.width", "value": 90 }]
          },
          {
            "matcher": { "id": "byName", "options": "entity" },
            "properties": [{ "id": "custom.inspect", "value": true }]
          },
          {
            "matcher": { "id": "byName", "options": "context" },
            "properties": [
              { "id": "custom.inspect", "value": true },
              { "id": "custom.width", "value": 260 }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT last_seen, severity, title, entity::text AS entity, event_count AS events, status, context::text AS context FROM detect.alerts WHERE status = ANY(ARRAY[${status:sqlstring}]::text[]) AND severity = ANY(ARRAY[${severity:sqlstring}]::text[]) ORDER BY last_seen DESC LIMIT 200"
        }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "Details (all fields)",
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "panels": [
        {
          "id": 2,
          "type": "table",
          "title": "Alerts — full detail",
          "gridPos": { "h": 12, "w": 24, "x": 0, "y": 19 },
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "caib" },
          "fieldConfig": {
            "defaults": { "custom": { "filterable": true } },
            "overrides": [
              {
                "matcher": { "id": "byName", "options": "entity" },
                "properties": [{ "id": "custom.inspect", "value": true }]
              },
              {
                "matcher": { "id": "byName", "options": "context" },
                "properties": [{ "id": "custom.inspect", "value": true }]
              }
            ]
          },
          "targets": [
            {
              "refId": "A",
              "format": "table",
              "rawSql": "SELECT last_seen, first_seen, severity, status, title, rule_id, dedup_key, event_count, entity::text AS entity, context::text AS context FROM detect.alerts WHERE status = ANY(ARRAY[${status:sqlstring}]::text[]) AND severity = ANY(ARRAY[${severity:sqlstring}]::text[]) ORDER BY last_seen DESC LIMIT 200"
            }
          ]
        }
      ]
    }
  ]
}
