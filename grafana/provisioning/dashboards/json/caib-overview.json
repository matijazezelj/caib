{
  "uid": "caib-overview",
  "title": "CAIB Overview",
  "tags": [
    "caib"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Events by module",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(bucket, '1h') AS time, module AS metric, sum(n)::float AS value FROM caib.events_5m WHERE $__timeFilter(bucket) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Failure rate by module",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(bucket, '1h') AS time, module AS metric, (sum(n) FILTER (WHERE outcome = 'failure'))::float / nullif(sum(n), 0) AS value FROM caib.events_5m WHERE $__timeFilter(bucket) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Top actors (24h)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT actor, module, sum(n) AS events, sum(failures) AS failures FROM caib.actors_1h WHERE bucket > now() - interval '24 hours' AND actor IS NOT NULL GROUP BY actor, module ORDER BY events DESC LIMIT 15"
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "actor"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "action"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "target"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "src_ip"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "Open alerts by severity",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT severity, count(*)::int AS alerts FROM detect.alerts WHERE status = 'open' GROUP BY severity ORDER BY array_position(ARRAY['critical','high','medium','low','info'], severity)"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Landing backlog",
      "description": "Rows waiting for the loader. Sustained growth = loader down or DB overloaded.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*)::int AS backlog FROM ingest.landing"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Dead letter (total)",
      "description": "Envelopes the loader refused. Non-empty = a mapping bug somewhere.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 12
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*)::int AS dead FROM ingest.dead_letter"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Timescale job errors (24h)",
      "description": "Compression/retention/cagg-refresh jobs are infrastructure too. 0 = healthy; on errors, query timescaledb_information.job_errors for the messages.",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*)::int AS job_errors FROM timescaledb_information.job_errors WHERE finish_time > now() - interval '24 hours'"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Ingest lag by module",
      "description": "Time since each module's newest event. Vendor delivery lag dominates (CloudTrail alone batches ~5-15 min); sustained growth = a stuck source. The dead-man rules page on this too. Bounded to the 2-day rowstore window, with the module list and the fallback timestamp coming from the 5m aggregate, so this never scans compressed chunks.",
      "gridPos": {
        "h": 6,
        "w": 14,
        "x": 4,
        "y": 16
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "lag_seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 3600
                    },
                    {
                      "color": "red",
                      "value": 21600
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH seen AS (SELECT module, max(bucket) AS newest FROM caib.events_5m WHERE bucket > now() - interval '30 days' GROUP BY module), hot AS (SELECT module, max(event_time) AS newest FROM caib.events WHERE event_time > now() - interval '2 days' GROUP BY module) SELECT s.module, extract(epoch FROM now() - coalesce(h.newest, s.newest))::int AS lag_seconds, coalesce(h.newest, s.newest) AS newest_event FROM seen s LEFT JOIN hot h USING (module) ORDER BY lag_seconds DESC"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Engine heartbeats",
      "description": "Seconds since the loader and detect loops last completed a cycle. A missing or stale detect row means detections have stopped — the dead-man rules cannot cover this, because a stopped engine evaluates nothing. Same check as the container healthchecks: caib-core healthcheck --service detect.",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 16
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "seconds_since_beat"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 120
                    },
                    {
                      "color": "red",
                      "value": 300
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT service, extract(epoch FROM now() - beat_at)::int AS seconds_since_beat FROM ops.heartbeat ORDER BY service"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Raw event stream",
      "description": "Newest events in the selected range, all modules. Click a cell in attrs/raw to inspect the full JSON; column headers filter.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "attrs"
            },
            "properties": [
              {
                "id": "custom.inspect",
                "value": true
              },
              {
                "id": "custom.width",
                "value": 220
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "raw"
            },
            "properties": [
              {
                "id": "custom.inspect",
                "value": true
              },
              {
                "id": "custom.width",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "actor"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "action"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "target"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "src_ip"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT event_time, module, actor, action, target, outcome, severity, host(src_ip) AS src_ip, attrs::text AS attrs, raw::text AS raw FROM caib.events WHERE $__timeFilter(event_time) ORDER BY event_time DESC LIMIT 100"
        }
      ]
    }
  ]
}
