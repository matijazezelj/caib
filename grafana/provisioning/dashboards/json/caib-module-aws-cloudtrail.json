{
  "uid": "caib-mod-aws-cloudtrail",
  "title": "CAIB Module: aws_cloudtrail",
  "tags": [
    "caib",
    "aws_cloudtrail"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Events per hour",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(bucket, '1h') AS time, outcome AS metric, sum(n)::float AS value FROM caib.events_5m WHERE module = 'aws_cloudtrail' AND $__timeFilter(bucket) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Top actors (24h)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT actor, sum(n) AS events, sum(failures) AS failures FROM caib.actors_1h WHERE module = 'aws_cloudtrail' AND bucket > now() - interval '24 hours' AND actor IS NOT NULL GROUP BY actor ORDER BY events DESC LIMIT 10"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Top actions (24h)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT action, sum(n) AS events FROM caib.events_5m WHERE module = 'aws_cloudtrail' AND bucket > now() - interval '24 hours' GROUP BY action ORDER BY events DESC LIMIT 10"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Recent failures",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT event_time, actor, action, attrs->>'error_code' AS error_code, host(src_ip) AS src_ip FROM caib.events WHERE module = 'aws_cloudtrail' AND outcome = 'failure' AND $__timeFilter(event_time) ORDER BY event_time DESC LIMIT 50"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Events by AWS service (24h)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT attrs->>'event_source' AS event_source, count(*) AS events FROM caib.events WHERE module = 'aws_cloudtrail' AND event_time > now() - interval '24 hours' GROUP BY 1 ORDER BY events DESC LIMIT 10"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Console sign-ins by MFA (7d)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT coalesce(attrs->>'mfa', 'unknown') AS mfa, count(*) AS logins FROM caib.events WHERE module = 'aws_cloudtrail' AND action = 'ConsoleLogin' AND event_time > now() - interval '7 days' GROUP BY 1 ORDER BY logins DESC"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Raw event stream",
      "description": "Newest aws_cloudtrail events in the selected range. Click a cell in attrs/raw to inspect the full JSON; column headers filter.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "caib"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "attrs"
            },
            "properties": [
              {
                "id": "custom.inspect",
                "value": true
              },
              {
                "id": "custom.width",
                "value": 220
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "raw"
            },
            "properties": [
              {
                "id": "custom.inspect",
                "value": true
              },
              {
                "id": "custom.width",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "actor"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "action"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "target"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "src_ip"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pivot: search this value",
                    "url": "/d/caib-search/x?var-q=${__value.text:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT event_time, actor, action, target, outcome, severity, host(src_ip) AS src_ip, attrs::text AS attrs, raw::text AS raw FROM caib.events WHERE module = 'aws_cloudtrail' AND $__timeFilter(event_time) ORDER BY event_time DESC LIMIT 100"
        }
      ]
    }
  ]
}
