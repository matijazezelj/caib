# CAIB environment. `make up` generates .env from this file with fresh random
# passwords — the values below are placeholders for reading, not for running.
# No real secrets in this file, ever.

# --- Exposure ---

# Host interface the published ports bind to. Loopback by default: a container
# port mapping bypasses ufw/firewalld (Docker writes its own iptables chain),
# so "0.0.0.0" here puts Postgres and Grafana on the internet. Put Grafana
# behind a TLS reverse proxy instead — see docs/DEPLOY.md.
CAIB_BIND_ADDR=127.0.0.1

# --- PostgreSQL (dev single-node compose) ---

# postgres superuser password; used by the dev container and the migrate entrypoint.
CAIB_PG_SUPERPASS=caib-dev-super

# caib_app role password: loader, detect, pollers, vector all connect as caib_app.
# Synced by `migrate` via ALTER ROLE (never stored in migration files).
CAIB_PG_APP_PASSWORD=caib-dev-app

# caib_ro role password: Grafana's read-only datasource.
CAIB_PG_RO_PASSWORD=caib-dev-ro

# caib_agent_ro role password: the agent query layer's least-privilege role.
# NOT the same role as caib_ro — caib_ro can read every table including the raw
# ingest.* landing tables (Grafana's Overview panels need them); caib_agent_ro
# gets SELECT on five named tables and nothing else. See docs/AGENT_API.md.
CAIB_AGENT_RO_PASSWORD=caib-dev-agent-ro

# Host port the dev database is published on (on CAIB_BIND_ADDR).
CAIB_PG_PORT=5432

# sslmode for every connection, app and Grafana alike. "prefer" encrypts when
# the server offers TLS and silently falls back when it doesn't — it verifies
# nothing. Anything crossing a network between hosts wants "verify-full" plus
# server certs; see docs/DEPLOY.md.
CAIB_PG_SSLMODE=prefer

# --- HA overlay (make ha-up) ---

# Streaming-replication password between the Patroni nodes.
CAIB_HA_REPLICATION_PASSWORD=caib-dev-replication

# --- Grafana ---

CAIB_GRAFANA_PORT=3000
CAIB_GRAFANA_ADMIN_PASSWORD=admin

# Database the Grafana datasource points at. Change when the DB is not the
# compose node (the HA overlay sets haproxy:5001 — replicas and primary).
#CAIB_GRAFANA_DS_URL=timescaledb:5432

# --- Loader ---

# Events moved landing -> events per transaction.
CAIB_LOADER_BATCH=5000
# Sleep between batches when landing is drained.
CAIB_LOADER_INTERVAL_S=5
# true = null out the raw vendor event on load (minor storage lever).
CAIB_DROP_RAW=false

# --- Detect / notifications ---

# Seconds subtracted from now() when sealing a watermark window; must exceed
# any loader transaction's age.
CAIB_DETECT_SAFETY_LAG=60
# Rows per rule per tick before the engine folds them into one meta-alert.
CAIB_DETECT_MAX_ALERTS_PER_TICK=500
# Seconds between notifications for a rule that keeps overflowing that cap. The
# meta-alert folds into a single row on purpose, so without this it would notify
# once and then go quiet while the flood continued. 0 = notify on every tick.
CAIB_DETECT_OVERFLOW_NOTIFY_INTERVAL=3600
# Where alert notifications POST to (Slack incoming webhook, etc.).
# Blank = notifications disabled (outbox drains without sending).
CAIB_NOTIFY_WEBHOOK_URL=
# Minimum severity that gets notified: info|low|medium|high|critical.
CAIB_NOTIFY_MIN_SEVERITY=info
# Payload format: json | slack (Block Kit). Unset = auto: slack when the URL
# is a hooks.slack.com incoming webhook, json otherwise.
#CAIB_NOTIFY_FORMAT=

# --- Retention (plain tables) ---

# caib.events is a hypertable and has a Timescale retention policy; these three
# are plain tables, so the detect loop sweeps them hourly instead. 0 = keep
# forever (the pre-0007 behaviour: unbounded growth).

# Delivered notifications kept in detect.outbox.
CAIB_RETENTION_OUTBOX_DAYS=30
# Closed alerts kept in detect.alerts. Open and acked alerts are NEVER deleted.
CAIB_RETENTION_ALERTS_CLOSED_DAYS=90
# Rejected envelopes kept in ingest.dead_letter. A non-empty dead_letter is a
# mapping bug, so keep this long enough to notice one.
CAIB_RETENTION_DEAD_LETTER_DAYS=30

# --- Agent query layer (compose profile "agent-api") ---

# Bearer token for the read-only HTTP/JSON API. There is no "no auth" mode:
# caib-agent-api refuses to start when this is empty, rather than serving your
# audit log to whoever finds the port. `make up` generates one.
CAIB_AGENT_API_TOKEN=caib-dev-agent-token

# Host port the API is published on (on CAIB_BIND_ADDR, loopback by default).
CAIB_AGENT_API_PORT=8088

# Interface caib-agent-api listens on INSIDE its container. 0.0.0.0 there is
# not exposure: the compose port mapping above is what decides who can reach
# it, and that binds to CAIB_BIND_ADDR. Running the binary outside a container
# defaults to 127.0.0.1 instead. Put it behind the same TLS reverse proxy as
# Grafana before letting anything off-host talk to it — see docs/DEPLOY.md.
#CAIB_AGENT_API_BIND=0.0.0.0

# --- Module: gcp_audit (compose profile "gcp_audit") ---

# GCP project holding the Pub/Sub subscription.
#CAIB_GCP_PROJECT=
# Subscription the Log Router sink's topic feeds.
#CAIB_GCP_SUBSCRIPTION=
# Path (on this host) to the subscriber service-account JSON key.
#CAIB_GCP_CREDENTIALS_FILE=

# --- Module: azure_activity (compose profile "azure_activity") ---

#CAIB_AZURE_TENANT_ID=
#CAIB_AZURE_CLIENT_ID=
#CAIB_AZURE_CLIENT_SECRET=
#CAIB_AZURE_SUBSCRIPTION_ID=
# First-run backfill start (RFC3339). Default: now()-24h. API max: 90 days.
#CAIB_AZURE_ACTIVITY_BACKFILL=

# --- Module: aws_cloudtrail (compose profile "aws_cloudtrail") ---

# SQS queue receiving S3 ObjectCreated notifications for the trail bucket.
#CAIB_CLOUDTRAIL_SQS_URL=
#CAIB_AWS_REGION=us-east-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# --- Module: cloudflare_audit (compose profile "cloudflare_audit") ---

# API token with account-level Audit Logs Read permission.
#CAIB_CLOUDFLARE_API_TOKEN=
# Cloudflare account id (dashboard -> account home -> right sidebar).
#CAIB_CLOUDFLARE_ACCOUNT_ID=
# First-run backfill start (RFC3339). Default: now()-24h.
#CAIB_CLOUDFLARE_AUDIT_BACKFILL=
