# CAIB environment. Copy to .env (make up does this automatically) and change
# every password for anything that isn't a throwaway dev stack.
# No real secrets in this file, ever.

# --- PostgreSQL (dev single-node compose) ---

# postgres superuser password; used by the dev container and the migrate entrypoint.
CAIB_PG_SUPERPASS=caib-dev-super

# caib_app role password: loader, detect, pollers, vector all connect as caib_app.
# Synced by `migrate` via ALTER ROLE (never stored in migration files).
CAIB_PG_APP_PASSWORD=caib-dev-app

# caib_ro role password: Grafana's read-only datasource.
CAIB_PG_RO_PASSWORD=caib-dev-ro

# Host port the dev database is published on.
CAIB_PG_PORT=5432

# --- Grafana ---

CAIB_GRAFANA_PORT=3000
CAIB_GRAFANA_ADMIN_PASSWORD=admin

# --- Loader ---

# Events moved landing -> events per transaction.
CAIB_LOADER_BATCH=5000
# Sleep between batches when landing is drained.
CAIB_LOADER_INTERVAL_S=5
# true = null out the raw vendor event on load (minor storage lever).
CAIB_DROP_RAW=false

# --- Module: cloudflare_audit (compose profile "cloudflare_audit") ---

# API token with account-level Audit Logs Read permission.
#CAIB_CLOUDFLARE_API_TOKEN=
# Cloudflare account id (dashboard -> account home -> right sidebar).
#CAIB_CLOUDFLARE_ACCOUNT_ID=
# First-run backfill start (RFC3339). Default: now()-24h.
#CAIB_CLOUDFLARE_AUDIT_BACKFILL=
