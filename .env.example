# CAIB environment. Copy to .env (make up does this automatically) and change
# every password for anything that isn't a throwaway dev stack.
# No real secrets in this file, ever.

# --- PostgreSQL (dev single-node compose) ---

# postgres superuser password; used by the dev container and the migrate entrypoint.
CAIB_PG_SUPERPASS=caib-dev-super

# caib_app role password: loader, detect, pollers, vector all connect as caib_app.
# Synced by `migrate` via ALTER ROLE (never stored in migration files).
CAIB_PG_APP_PASSWORD=caib-dev-app

# caib_ro role password: Grafana's read-only datasource.
CAIB_PG_RO_PASSWORD=caib-dev-ro

# Host port the dev database is published on.
CAIB_PG_PORT=5432

# --- Grafana ---

CAIB_GRAFANA_PORT=3000
CAIB_GRAFANA_ADMIN_PASSWORD=admin

# --- Loader ---

# Events moved landing -> events per transaction.
CAIB_LOADER_BATCH=5000
# Sleep between batches when landing is drained.
CAIB_LOADER_INTERVAL_S=5
# true = null out the raw vendor event on load (minor storage lever).
CAIB_DROP_RAW=false

# --- Detect / notifications ---

# Seconds subtracted from now() when sealing a watermark window; must exceed
# any loader transaction's age.
CAIB_DETECT_SAFETY_LAG=60
# Rows per rule per tick before the engine folds them into one meta-alert.
CAIB_DETECT_MAX_ALERTS_PER_TICK=500
# Where alert notifications POST to (Slack incoming webhook, etc.).
# Blank = notifications disabled (outbox drains without sending).
CAIB_NOTIFY_WEBHOOK_URL=
# Minimum severity that gets notified: info|low|medium|high|critical.
CAIB_NOTIFY_MIN_SEVERITY=info

# --- Module: gcp_audit (compose profile "gcp_audit") ---

# GCP project holding the Pub/Sub subscription.
#CAIB_GCP_PROJECT=
# Subscription the Log Router sink's topic feeds.
#CAIB_GCP_SUBSCRIPTION=
# Path (on this host) to the subscriber service-account JSON key.
#CAIB_GCP_CREDENTIALS_FILE=

# --- Module: azure_activity (compose profile "azure_activity") ---

#CAIB_AZURE_TENANT_ID=
#CAIB_AZURE_CLIENT_ID=
#CAIB_AZURE_CLIENT_SECRET=
#CAIB_AZURE_SUBSCRIPTION_ID=
# First-run backfill start (RFC3339). Default: now()-24h. API max: 90 days.
#CAIB_AZURE_ACTIVITY_BACKFILL=

# --- Module: aws_cloudtrail (compose profile "aws_cloudtrail") ---

# SQS queue receiving S3 ObjectCreated notifications for the trail bucket.
#CAIB_CLOUDTRAIL_SQS_URL=
#CAIB_AWS_REGION=us-east-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# --- Module: cloudflare_audit (compose profile "cloudflare_audit") ---

# API token with account-level Audit Logs Read permission.
#CAIB_CLOUDFLARE_API_TOKEN=
# Cloudflare account id (dashboard -> account home -> right sidebar).
#CAIB_CLOUDFLARE_ACCOUNT_ID=
# First-run backfill start (RFC3339). Default: now()-24h.
#CAIB_CLOUDFLARE_AUDIT_BACKFILL=
